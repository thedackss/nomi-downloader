{
    "manifest_version": 3,
    "name": "Nomi Downloader",
    "description": "Back up your nomi.ai companions: save albums, chats, voice, mind maps and shared notes as offline HTML, Markdown and JSON files.",
    "version": "0.4.4",
    "action": { "default_popup": "index.html" },

    "host_permissions": ["https://*.nomi.ai/*"],
    "content_scripts": [
        {
            "matches": ["https://*.nomi.ai/*"],
            "js": ["src/content/index.ts"]
        }
    ],

    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },

    "permissions": ["downloads", "offscreen", "storage"],

    "web_accessible_resources": [
        {
            "resources": ["src/offscreen/index.html"],
            "matches": ["<all_urls>"]
        }
    ],

    "icons": {
        "16": "icons/icon_16x16.png",
        "32": "icons/icon_32x32.png",
        "48": "icons/icon_48x48.png",
        "128": "icons/icon_128x128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@nomi-downloader",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": ["technicalAndInteraction"]
            }
        }
    }
}
