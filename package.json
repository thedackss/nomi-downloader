{
    "name": "nomi-extension",
    "private": true,
    "version": "0.4.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:firefox": "BROWSER_TARGET=firefox vite",
        "build:firefox": "tsc -b && BROWSER_TARGET=firefox vite build",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:e2e": "npm run build && xvfb-run -a playwright test",
        "preview": "vite preview"
    },
    "dependencies": {
        "axios": "^1.13.4",
        "jszip": "^3.10.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.0.0-beta.33",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.61.1",
        "@types/chrome": "^0.1.36",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "sass-embedded": "^1.97.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4",
        "vitest": "^4.1.9"
    }
}
