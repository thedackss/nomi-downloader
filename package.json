{
    "name": "nomi-extension",
    "private": true,
    "version": "0.4.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:firefox": "BROWSER_TARGET=firefox vite",
        "build:firefox": "tsc -b && BROWSER_TARGET=firefox vite build",
        "build": "tsc -b && vite build",
        "lint": "biome lint && npm run lint:scss",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "format": "biome check --write && npm run format:scss",
        "format:scss": "stylelint --fix \"src/**/*.scss\" && prettier --write \"src/**/*.scss\"",
        "test": "vitest run",
        "test:e2e": "npm run build && xvfb-run -a playwright test",
        "preview": "vite preview"
    },
    "dependencies": {
        "axios": "^1.13.4",
        "jszip": "^3.10.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.1",
        "@crxjs/vite-plugin": "^2.0.0-beta.33",
        "@playwright/test": "^1.61.1",
        "@types/chrome": "^0.1.36",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "prettier": "^3.8.4",
        "sass-embedded": "^1.97.3",
        "stylelint": "^17.13.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vitest": "^4.1.9"
    }
}
