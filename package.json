{
    "name": "nomi-extension",
    "private": true,
    "version": "0.4.4",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:firefox": "BROWSER_TARGET=firefox vite",
        "build:firefox": "tsc -b && BROWSER_TARGET=firefox vite build",
        "start:firefox-android": "npm run build:firefox && web-ext run -t firefox-android --source-dir dist",
        "build": "tsc -b && vite build",
        "release": "node scripts/package-extension.mjs",
        "lint": "biome lint ; npm run lint:scss",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "format": "biome check --write && npm run format:scss",
        "format:scss": "stylelint --fix \"src/**/*.scss\" && prettier --write \"src/**/*.scss\"",
        "test": "vitest run",
        "test:e2e": "npm run build && xvfb-run -a playwright test",
        "preview": "vite preview",
        "preview:chat": "vite --config vite.preview.config.ts",
        "preview:mindmap": "vite --config vite.preview.mindmap.config.ts",
        "preview:notes": "vite --config vite.preview.notes.config.ts"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "jszip": "^3.10.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@crxjs/vite-plugin": "^2.7.1",
        "@playwright/test": "^1.63.0",
        "@types/chrome": "^0.2.9",
        "@types/node": "^24.13.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "prettier": "^3.9.6",
        "sass-embedded": "^1.104.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vitest": "^4.1.11",
        "web-ext": "^10.4.0"
    }
}
