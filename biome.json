{
    "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**", "!package-lock.json", "!**/*.scss"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "tab"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "indentWidth": 4,
            "indentStyle": "space",
            "arrowParentheses": "always",
            "bracketSameLine": true
        }
    },
    "css": {
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "indentStyle": "space"
        }
    },
    "json": {
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "indentStyle": "space"
        }
    },
    "html": {
        "formatter": {
            "enabled": true,
            "indentWidth": 4,
            "indentStyle": "space"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["e2e/**/*.ts", "playwright.config.ts"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useHookAtTopLevel": "off"
                    }
                }
            }
        }
    ]
}
